---
import { Image } from 'astro:assets';
import collabBadge from '@/assets/cuchito-x-chocobets.png';
import { chocoBets } from '@/data/chocobets';
import { communityChannels } from '@/data/channels';
import Icon from '@/components/ui/Icon.astro';

const predictionChannels = communityChannels.filter((c) => c.category === 'Pronósticos');
---

<section class="section chocobets" id="pronosticos">
  <div class="chocobets__ambient" aria-hidden="true"></div>
  <div class="container chocobets__panel" data-reveal>
    <div class="chocobets__copy">
      <p class="chocobets__eyebrow">
        <Icon name="trending-up" class="chocobets__eyebrow-icon" size={16} strokeWidth={2} />
        {chocoBets.eyebrow}
      </p>
      <h2 class="chocobets__title">{chocoBets.title}</h2>
      <p class="chocobets__desc">{chocoBets.description}</p>

      <ul class="chocobets__benefits">
        {chocoBets.benefits.map((benefit) => (
          <li>
            <Icon name="target" class="chocobets__benefit-icon" size={17} strokeWidth={1.8} />
            <span>{benefit}</span>
          </li>
        ))}
      </ul>

      <div class="chocobets__actions">
        <button type="button" class="chocobets__cta" id="chocobets-open" aria-haspopup="dialog">
          {chocoBets.cta}
          <Icon name="arrow-right" class="chocobets__cta-icon" size={17} strokeWidth={2} />
        </button>

        {predictionChannels.length > 0 && (
          <div class="chocobets__alt">
            <span>También en:</span>
            {predictionChannels.map((channel) => (
              <a
                href={channel.href}
                target="_blank"
                rel="noopener noreferrer"
                class="chocobets__alt-link"
              >
                <Icon name={channel.icon} size={15} strokeWidth={1.8} />
                {channel.platform === 'telegram' ? 'Telegram' : 'WhatsApp'}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="chocobets__mark">
      <Image
        src={collabBadge}
        alt="Colaboración oficial Cuchito Army x Choco Bets — Premium VIP"
        width={320}
        height={320}
        class="chocobets__mark-img"
        loading="lazy"
        format="webp"
        quality={82}
      />
    </div>
  </div>
</section>

<script>
  import '@/scripts/chocobets-modal';
</script>

<style>
  .chocobets {
    position: relative;
    overflow: clip;
  }

  .chocobets__ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 90% at 15% 30%, rgba(20, 184, 166, 0.14), transparent 65%),
      radial-gradient(ellipse 45% 70% at 90% 70%, rgba(255, 152, 0, 0.1), transparent 65%);
    pointer-events: none;
  }

  .chocobets__panel {
    position: relative;
    display: grid;
    gap: 32px;
    align-items: center;
    padding: 40px 28px;
    background: linear-gradient(160deg, var(--surface) 0%, var(--surface-elevated) 100%);
    border: 1px solid rgba(20, 184, 166, 0.28);
    border-radius: var(--radius-lg);
  }

  .chocobets__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2dd4bf;
  }

  .chocobets__title {
    margin-top: 14px;
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    color: var(--text-primary);
    max-width: 20ch;
  }

  .chocobets__desc {
    margin-top: 14px;
    max-width: 54ch;
    font-size: var(--fs-body-lg);
    color: var(--text-secondary);
  }

  .chocobets__benefits {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin-top: 24px;
  }

  .chocobets__benefits li {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: var(--fs-body);
    color: var(--text-secondary);
  }

  :global(.chocobets__benefit-icon) {
    flex-shrink: 0;
    color: #2dd4bf;
  }

  .chocobets__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .chocobets__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 30px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-body);
    color: #04211d;
    background: linear-gradient(135deg, #2dd4bf 0%, #14b8a6 100%);
    border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px -10px rgba(20, 184, 166, 0.55);
    transition: transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .chocobets__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px -8px rgba(20, 184, 166, 0.7);
  }

  :global(.chocobets__cta-icon) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .chocobets__cta:hover :global(.chocobets__cta-icon) {
    transform: translateX(3px);
  }

  .chocobets__alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-small);
    color: var(--text-tertiary);
  }

  .chocobets__alt-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color var(--duration-base) var(--ease-out);
  }

  .chocobets__alt-link:hover {
    color: #2dd4bf;
  }

  .chocobets__mark {
    display: flex;
    justify-content: center;
    justify-self: center;
  }

  .chocobets__mark-img {
    width: min(220px, 60vw);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    filter: drop-shadow(0 20px 45px rgba(20, 184, 166, 0.4));
  }

  /* Mobile only: center the CTA + alt-channel row as a unit. Desktop keeps
     the left-aligned layout from .chocobets__actions' base rule. */
  @media (max-width: 899.98px) {
    .chocobets__actions {
      justify-content: center;
      text-align: center;
    }

    .chocobets__alt {
      justify-content: center;
    }
  }

  @media (min-width: 900px) {
    .chocobets__panel {
      grid-template-columns: 1.4fr 1fr;
      padding: 56px 64px;
    }
    .chocobets__mark-img {
      width: min(300px, 100%);
    }
  }
</style>
