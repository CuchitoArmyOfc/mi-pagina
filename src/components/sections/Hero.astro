---
import { Image } from 'astro:assets';
import mascot from '@/assets/mascot.png';
import Button from '@/components/ui/Button.astro';

const eyebrow = 'Comunidad oficial';
const subtitle = 'Contenido, comunidad y servicios en un solo lugar.';
---

<section class="hero" id="inicio">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="hero__title">
        CUCHITO<br />
        <span class="hero__title-accent">ARMY</span>
      </h1>
      <p class="hero__subtitle">{subtitle}</p>
      <div class="hero__actions">
        <Button href="#comunidad" size="lg" variant="primary">Únete a la Army</Button>
        <Button href="#servicios" size="lg" variant="secondary" showArrow>Explorar servicios</Button>
      </div>
    </div>

    <div class="hero__art" data-reveal>
      <div class="hero__ring" aria-hidden="true"></div>
      <Image
        src={mascot}
        alt="Mascota oficial de Cuchito Army"
        width={520}
        height={520}
        class="hero__mascot"
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={82}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: 56px var(--section-y);
  }

  /* Landscape phones: reclaim vertical room so the CTAs sit closer to the
     fold instead of fighting the same padding used on tall portrait screens. */
  @media (max-height: 500px) {
    .hero {
      padding-block: 24px 32px;
    }
    .hero__grid {
      gap: 28px;
    }
  }

  .hero__glow {
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 720px;
    background: var(--gradient-hero-glow);
    pointer-events: none;
    z-index: 0;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero__title {
    font-size: var(--fs-hero);
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .hero__title-accent {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__subtitle {
    max-width: 46ch;
    font-size: var(--fs-body-lg);
    color: var(--text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 10px;
    width: 100%;
  }

  /* Narrow phones: full-width stacked CTAs read as more premium and give
     bigger tap targets than two auto-width pills competing for room. */
  @media (max-width: 479.98px) {
    .hero__actions {
      flex-direction: column;
    }

    .hero__actions :global(.btn) {
      width: 100%;
    }
  }

  .hero__art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__ring {
    position: absolute;
    width: min(420px, 78vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 152, 0, 0.35) 0%, rgba(255, 106, 0, 0.08) 55%, transparent 75%);
    filter: blur(6px);
    animation: pulseRing 6s ease-in-out infinite;
  }

  @keyframes pulseRing {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.05);
      opacity: 1;
    }
  }

  .hero__mascot {
    position: relative;
    width: min(360px, 72vw);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 152, 0, 0.35);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ring {
      animation: none;
    }
  }

  @media (max-height: 500px) {
    .hero__mascot {
      width: min(200px, 42vw);
    }
  }

  @media (min-width: 860px) {
    .hero {
      padding-block: 96px var(--section-y);
    }
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 40px;
    }
    .hero__mascot {
      width: min(440px, 100%);
    }
  }
</style>
