---

<section class="ticker" aria-label="Actividad de la comunidad">
  <div class="container ticker__panel" data-reveal>
    <div class="ticker__viewport">
      <ul class="ticker__track">
        {track.map((message) => (
          <li class="ticker__item">
            <Icon name="users" size={15} strokeWidth={1.8} />
            <span>{message}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ticker {
    padding-block: 8px;
  }

  .ticker__panel {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .ticker__viewport {
    height: 210px;
    overflow: hidden;
    mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
  }

  .ticker__track {
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: ticker-scroll 140s linear infinite;
  }

  .ticker__item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 16px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    color: var(--text-secondary);
  }

  .ticker__item :global(svg) {
    color: #2dd4bf;
    flex-shrink: 0;
  }

  @keyframes ticker-scroll {
    from {
      /* Track is doubled, so starting at -50% and animating to 0%
         moves the visible content downward, then loops with no seam. */
      transform: translateY(-50%);
    }
    to {
      transform: translateY(0%);
    }
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
    .ticker__viewport {
      overflow-y: auto;
    }
  }
</style>
