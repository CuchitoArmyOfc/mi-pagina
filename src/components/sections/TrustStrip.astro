---
import { trustItems } from '@/data/trust';
---

<section class="trust" aria-label="Cuchito Army en cifras">
  <div class="container trust__bar" data-reveal>
    {trustItems.map((item, i) => (
      <>
        {i > 0 && <span class="trust__sep" aria-hidden="true"></span>}
        <div class="trust__item">
          <span class="trust__value">{item.value}</span>
          <span class="trust__label">{item.label}</span>
        </div>
      </>
    ))}
  </div>
</section>

<style>
  .trust {
    padding-block: 8px;
  }

  .trust__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 28px;
    padding: 28px var(--page-px);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 96px;
  }

  .trust__value {
    font-family: var(--font-display);
    font-size: 2.1rem;
    letter-spacing: 0.02em;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .trust__label {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-secondary);
  }

  .trust__sep {
    display: none;
    width: 1px;
    height: 40px;
    background: var(--border-default);
  }

  @media (min-width: 560px) {
    .trust__sep {
      display: block;
    }
  }
</style>
