---
import { Image } from 'astro:assets';
import premiumBadge from '@/assets/premium-vip.png';
import { premiumFeature, premiumBenefits } from '@/data/premium';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
---

<section class="section premium" id="premium">
  <div class="premium__glow" aria-hidden="true"></div>
  <div class="container premium__panel" data-reveal>
    <div class="premium__copy">
      <Badge accent="purple">{premiumFeature.category}</Badge>
      <h2 class="premium__title">{premiumFeature.title}</h2>
      <p class="premium__desc">{premiumFeature.description}</p>
      <ul class="premium__list">
        {premiumBenefits.map((benefit) => (
          <li>
            <Icon name="crown" class="premium__list-icon" size={18} strokeWidth={1.6} />
            <span>{benefit}</span>
          </li>
        ))}
      </ul>
      <Button href={premiumFeature.href} variant="primary" size="lg" external class="premium__cta">
        {premiumFeature.cta}
      </Button>
    </div>

    <div class="premium__art">
      <Image
        src={premiumBadge}
        alt="Cuchito Army VIP Premium: contenido exclusivo, acceso prioritario, sin anuncios"
        width={420}
        height={420}
        class="premium__badge"
        loading="lazy"
        format="webp"
        quality={82}
      />
    </div>
  </div>
</section>

<style>
  .premium {
    position: relative;
    overflow: clip;
  }

  .premium__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(139, 44, 255, 0.16), transparent 70%);
    pointer-events: none;
  }

  .premium__panel {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
    padding: 40px 28px;
    background: linear-gradient(160deg, var(--surface) 0%, var(--surface-elevated) 100%);
    border: 1px solid rgba(139, 44, 255, 0.25);
    border-radius: var(--radius-lg);
  }

  .premium__copy {
    max-width: 560px;
  }

  .premium__title {
    margin-top: 16px;
    color: var(--text-primary);
  }

  .premium__desc {
    margin-top: 16px;
    font-size: var(--fs-body-lg);
    color: var(--text-secondary);
  }

  .premium__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 28px;
    margin-bottom: 32px;
  }

  .premium__list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-body);
    color: var(--text-secondary);
  }

  :global(.premium__list-icon) {
    flex-shrink: 0;
    color: var(--purple);
  }

  :global(.premium__cta) {
    background: var(--gradient-premium) !important;
    box-shadow: 0 8px 28px -8px rgba(139, 44, 255, 0.55) !important;
  }

  .premium__art {
    display: flex;
    justify-content: center;
  }

  .premium__badge {
    width: min(280px, 70vw);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: var(--radius-lg);
    filter: drop-shadow(0 20px 50px rgba(139, 44, 255, 0.35));
  }

  /* Mobile only: center the CTA button. Desktop keeps it left-aligned
     under the left-aligned copy. */
  @media (max-width: 859.98px) {
    :global(.premium__cta) {
      /* !important: must beat Button.astro's own `.btn { display: inline-flex }`,
         which loads as a later stylesheet with equal (single-class) specificity. */
      display: flex !important;
      width: fit-content !important;
      margin-inline: auto !important;
    }
  }

  @media (min-width: 860px) {
    .premium__panel {
      grid-template-columns: 1.3fr 1fr;
      padding: 56px 72px;
    }

    .premium__badge {
      width: min(340px, 100%);
    }
  }
</style>
