---
import { communityChannels } from '@/data/channels';
import ChannelCard from '@/components/ui/ChannelCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

// Pronósticos/Fijas live in the dedicated ChocoBetsSpotlight section instead,
// so they aren't listed twice across the page.
const mainChannels = communityChannels.filter((c) => c.category !== 'Pronósticos');
---

<section class="section" id="comunidad">
  <div class="container">
    <SectionHeading
      eyebrow="Comunidad"
      title="Habla, comparte y mantente al día"
      description="Telegram y WhatsApp reunidos en un solo lugar: elige el canal que más te acomode."
    />

    <div class="channels-list">
      {mainChannels.map((channel) => <ChannelCard channel={channel} />)}
    </div>
  </div>
</section>

<style>
  .channels-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 720px) {
    .channels-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
