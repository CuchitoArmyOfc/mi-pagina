---
/**
 * Zero-dependency, Lucide-style stroke icon set. No emoji anywhere in the
 * interface — every icon here is a coherent 24x24 stroke SVG.
 *
 * Sizing uses the `size` prop (-> inline style), not CSS classes. Astro
 * scopes a component's own <style> block to its own root elements, so a
 * parent's scoped CSS can never reliably win a specificity fight against
 * this file's own rules for the <svg> it renders — inline style sidesteps
 * that entirely. `class` is still available for non-sizing concerns
 * (hover transforms, etc.).
 */
export interface Props {
  name:
    | 'shield'
    | 'bot'
    | 'crown'
    | 'video'
    | 'send'
    | 'users'
    | 'chat'
    | 'broadcast'
    | 'target'
    | 'lifebuoy'
    | 'search'
    | 'menu'
    | 'close'
    | 'arrow-right'
    | 'mascot-ring'
    | 'trending-up'
    | 'code';
  class?: string;
  strokeWidth?: number;
  /** Rendered width/height in pixels. Defaults to 24 (the icon's viewBox). */
  size?: number;
}

const { name, class: className, strokeWidth = 1.75, size = 24 } = Astro.props;

const paths: Record<string, string> = {
  shield: 'M12 21.5s7.5-3.6 7.5-9.4V5.6L12 2.6 4.5 5.6v6.5c0 5.8 7.5 9.4 7.5 9.4Z',
  bot: 'M5 10.5h14a1.6 1.6 0 0 1 1.6 1.6v5.4A1.6 1.6 0 0 1 19 19.1H5a1.6 1.6 0 0 1-1.6-1.6v-5.4A1.6 1.6 0 0 1 5 10.5Z M12 10.5V6.7 M12 4.9a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8Z M2.2 14.3h1.4 M20.4 14.3h1.4 M8.6 14.8v.6 M15.4 14.8v.6',
  crown: 'M4 18.5h16 M4.6 18 3.4 8.8l4.8 4 3.8-6.6 3.8 6.6 4.8-4L19.4 18',
  video: 'M3.5 6.8h13.2v10.4H3.5Z M16.7 9.6 20.5 6.8v10.4l-3.8-2.8Z',
  send: 'm21.6 2.4-10.2 10.6 M21.6 2.4 14.9 21.2l-3.5-8.2-8-3.6Z',
  users: 'M9 12.4a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Z M2.6 20.4c0-3.7 2.9-6.7 6.4-6.7s6.4 3 6.4 6.7 M16.1 6.4a2.9 2.9 0 1 1 0 5.8 M15.4 14.3c2.6.5 4.7 2.8 5 5.8',
  chat: 'M21 12.4c0 4.4-4 7.9-9 7.9-1.6 0-3-.3-4.3-.9L3 20.6l1.3-3.8A7.9 7.9 0 0 1 3 12.4c0-4.4 4-7.9 9-7.9s9 3.5 9 7.9Z',
  broadcast: 'M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z M8.8 9.2a4.6 4.6 0 0 0 0 5.6 M15.2 9.2a4.6 4.6 0 0 1 0 5.6 M6 6.4a8.4 8.4 0 0 0 0 11.2 M18 6.4a8.4 8.4 0 0 1 0 11.2',
  target: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M12 16.2a4.2 4.2 0 1 0 0-8.4 4.2 4.2 0 0 0 0 8.4Z M12 12.9a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Z',
  lifebuoy:
    'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M12 15.3a3.3 3.3 0 1 0 0-6.6 3.3 3.3 0 0 0 0 6.6Z M5.3 5.3l3.2 3.2 M18.7 5.3l-3.2 3.2 M15.5 15.5l3.2 3.2 M8.5 15.5l-3.2 3.2',
  search: 'M11 18.5a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15Z M21.5 21.5l-4.8-4.8',
  menu: 'M4 7.5h16 M4 12.5h16 M4 17.5h16',
  close: 'M18.5 5.5 5.5 18.5 M5.5 5.5l13 13',
  'arrow-right': 'M4.5 12.5h15 M13.5 6l6.5 6.5-6.5 6.5',
  'mascot-ring': 'M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19Z',
  'trending-up': 'M3 17.5 9 11.5 13 15.5 21 7.5 M15 7.5h6v6',
  code: 'm9 18-6-6 6-6 M15 6l6 6-6 6',
};

const d = paths[name] ?? '';
---

<svg
  class={className}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d}></path>
</svg>
