---
import type { Service } from '@/types/service';
import Icon from './Icon.astro';
import Badge from './Badge.astro';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
const externalProps = service.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={service.href}
  class:list={['card', `card--${service.accent}`, { 'card--featured': service.featured }]}
  data-reveal
  {...externalProps}
>
  <div class="card__top">
    <span class="card__icon"><Icon name={service.icon} size={22} strokeWidth={1.6} /></span>
    <Badge accent={service.accent}>{service.category}</Badge>
  </div>
  <h3 class="card__title">{service.title}</h3>
  <p class="card__desc">{service.description}</p>
  <span class="card__cta">
    {service.cta}
    <Icon name="arrow-right" class="card__cta-icon" size={15} strokeWidth={2} />
  </span>
</a>

<style>
  .card {
    --accent-color: var(--orange);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 30px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    transition: transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .card--orange {
    --accent-color: var(--orange);
  }
  .card--green {
    --accent-color: var(--green);
  }
  .card--purple {
    --accent-color: var(--purple);
  }
  .card--blue {
    --accent-color: var(--blue);
  }

  .card--featured {
    grid-column: span 2;
    background: linear-gradient(160deg, var(--surface) 0%, var(--surface-elevated) 100%);
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent-color) 45%, var(--border-default));
    background: var(--surface-hover);
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent-color) 14%, transparent);
    color: var(--accent-color);
  }

  .card__title {
    color: var(--text-primary);
  }

  .card--featured .card__title {
    font-size: 1.6rem;
  }

  .card__desc {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    flex: 1;
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--accent-color);
  }

  :global(.card__cta-icon) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .card:hover :global(.card__cta-icon) {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .card--featured {
      grid-column: span 1;
    }
  }
</style>
