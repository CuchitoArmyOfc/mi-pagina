---
import { primaryNav } from '@/data/navigation';
import { communityChannels } from '@/data/channels';
import Icon from '@/components/ui/Icon.astro';

const year = new Date().getFullYear();
const officialChannels = communityChannels.filter((c) => c.category !== 'Pronósticos');
---

<footer class="footer" id="contacto">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="#inicio" class="footer__logo-row">
        <img src="/logo.png" width="32" height="32" alt="" class="footer__logo" loading="lazy" />
        <span>CUCHITO ARMY</span>
      </a>
      <p class="footer__tagline">Contenido, comunidad y servicios en un solo lugar.</p>
    </div>

    <nav class="footer__col" aria-label="Navegación">
      <h3 class="footer__heading">Navegación</h3>
      <ul>
        {primaryNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Canales oficiales">
      <h3 class="footer__heading">Canales oficiales</h3>
      <ul>
        {officialChannels.map((channel) => (
          <li>
            <a href={channel.href} target="_blank" rel="noopener noreferrer">{channel.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>© {year} Cuchito Army Oficial. Todos los derechos reservados.</p>
    <a
      href="https://t.me/FantasminDox"
      target="_blank"
      rel="noopener noreferrer"
      class="footer__credit"
    >
      <Icon name="code" size={14} strokeWidth={2} />
      <span>Diseñado y desarrollado por <strong>@FantasminDox</strong></span>
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding-block: 64px 28px;
  }

  .footer__grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr;
  }

  .footer__brand {
    max-width: 320px;
  }

  .footer__logo-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .footer__logo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer__tagline {
    font-size: var(--fs-small);
    color: var(--text-tertiary);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 16px;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer__col a {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    transition: color var(--duration-base) var(--ease-out);
  }

  .footer__col a:hover {
    color: var(--orange);
  }

  .footer__bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--fs-small);
    color: var(--text-tertiary);
  }

  .footer__credit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 8px 16px;
    color: var(--text-tertiary);
    background: var(--surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    transition: transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .footer__credit :global(svg) {
    flex-shrink: 0;
    color: var(--text-tertiary);
    transition: color var(--duration-base) var(--ease-out);
  }

  .footer__credit strong {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .footer__credit:hover {
    transform: translateY(-2px);
    border-color: var(--orange);
    color: var(--text-secondary);
  }

  .footer__credit:hover :global(svg) {
    color: var(--orange);
  }

  .footer__credit:hover strong {
    color: var(--orange);
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }

    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .footer__credit {
      align-self: center;
    }
  }
</style>
